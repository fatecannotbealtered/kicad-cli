{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tool-driver-cli-spec:verification-result:2.0",
  "title": "verification-result",
  "description": "Optional structured observations at receipt.outcome.verification.extensions.verification_result. This format cannot authenticate native truth or source independence.",
  "type": "object",
  "properties": {
    "profile": {"const": "urn:tool-driver-cli-spec:verification-result:2.0"},
    "target": {"$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/target"},
    "snapshot": {"anyOf": [{"$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/snapshot"}, {"type": "null"}]},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "not_checked": {"type": "array", "items": {"$ref": "#/$defs/unchecked"}}
  },
  "required": ["profile", "target", "snapshot", "requirements", "observations", "not_checked"],
  "additionalProperties": false,
  "$defs": {
    "pointer": {"type": "string", "maxLength": 256, "pattern": "^(?:/(?:[^~/]|~[01])*)*$"},
    "value": {
      "type": "object",
      "properties": {
        "value": {},
        "unit": {"anyOf": [{"$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"}, {"type": "null"}]}
      },
      "required": ["value", "unit"],
      "additionalProperties": false
    },
    "source_kind": {
      "enum": ["application_readback", "file_consumer", "device_readback", "native_checker", "custom_checker", "screenshot", "writer_self_check", "input_echo", "unavailable", "unsupported"]
    },
    "sources": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"}
    },
    "comparison": {
      "oneOf": [
        {
          "type": "object", "properties": {"operator": {"const": "equals"}},
          "required": ["operator"], "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {"operator": {"const": "within_tolerance"}, "absolute": {"type": "number", "minimum": 0}},
          "required": ["operator", "absolute"], "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operator": {"const": "no_new_findings"},
            "identity_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/pointer"}}
          },
          "required": ["operator", "identity_fields"], "additionalProperties": false
        }
      ]
    },
    "requirement": {
      "type": "object",
      "properties": {
        "id": {"$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"},
        "kind": {"enum": ["field", "structure", "visual"]},
        "field_path": {"$ref": "#/$defs/pointer"},
        "expected": {"$ref": "#/$defs/value"},
        "comparison": {"$ref": "#/$defs/comparison"},
        "allowed_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/source_kind"}},
        "independence": {
          "type": "object",
          "properties": {
            "required": {"type": "boolean"},
            "writer_sources": {"$ref": "#/$defs/sources"},
            "expectation_sources": {"$ref": "#/$defs/sources"}
          },
          "required": ["required", "writer_sources", "expectation_sources"], "additionalProperties": false
        }
      },
      "required": ["id", "kind", "field_path", "expected", "comparison", "allowed_sources", "independence"],
      "additionalProperties": false
    },
    "unchecked": {
      "type": "object",
      "properties": {
        "field_path": {"$ref": "#/$defs/pointer"},
        "required": {"type": "boolean"},
        "reason": {"$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"}
      },
      "required": ["field_path", "required", "reason"], "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "requirement_id": {"$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"},
        "observed": {"anyOf": [{"$ref": "#/$defs/value"}, {"type": "null"}]},
        "source": {
          "type": "object",
          "properties": {
            "kind": {"$ref": "#/$defs/source_kind"},
            "completion": {"enum": ["completed", "running", "timeout", "unknown", "unavailable", "unsupported"]},
            "target": {"$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/target"},
            "snapshot": {"anyOf": [{"$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/snapshot"}, {"type": "null"}]},
            "method": {"$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"},
            "evidence_ref": {"$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"},
            "defect_sources": {"$ref": "#/$defs/sources"},
            "independence_basis": {"type": "string"},
            "coverage": {
              "type": "object",
              "properties": {
                "checked_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/pointer"}},
                "not_checked": {"type": "array", "items": {"$ref": "#/$defs/unchecked"}}
              },
              "required": ["checked_paths", "not_checked"], "additionalProperties": false
            }
          },
          "required": ["kind", "completion", "target", "snapshot", "method", "evidence_ref", "defect_sources", "independence_basis", "coverage"],
          "additionalProperties": false
        }
      },
      "required": ["requirement_id", "observed", "source"], "additionalProperties": false
    }
  }
}
