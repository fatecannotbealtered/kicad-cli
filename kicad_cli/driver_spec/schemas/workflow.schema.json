{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tool-driver-cli-spec:workflow:2.0",
  "title": "workflow",
  "description": "A dependent multi-step workflow. Independent items use the base batch shape (batch.schema.json).",
  "type": "object",
  "properties": {
    "operation_id": {
      "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"
    },
    "observed_at": {
      "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/timestamp"
    },
    "failure_policy": {
      "enum": [
        "stop",
        "continue_independent"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"
            },
            "uniqueItems": true
          },
          "phase": {
            "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/phase"
          },
          "effects": {
            "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/effects"
          },
          "operation_id": {
            "anyOf": [
              {
                "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "not_started",
              "running",
              "completed",
              "failed",
              "skipped",
              "cancelled",
              "unknown"
            ]
          },
          "receipt": {
            "anyOf": [
              {
                "$ref": "urn:tool-driver-cli-spec:receipt:2.0"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_refs": {
            "type": "array",
            "items": {
              "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
            }
          },
          "skip_reason": {
            "anyOf": [
              {
                "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/item_error"
              },
              {
                "type": "null"
              }
            ]
          },
          "checkpoint_ref": {
            "anyOf": [
              {
                "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
              },
              {
                "type": "null"
              }
            ]
          },
          "extensions": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "depends_on",
          "phase",
          "effects",
          "operation_id",
          "status",
          "receipt",
          "output_refs",
          "skip_reason",
          "error"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "skipped"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "skip_reason": {
                  "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "failed",
                    "unknown"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "error": {
                  "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/item_error"
                }
              }
            }
          }
        ]
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "not_started": {
          "type": "integer",
          "minimum": 0
        },
        "running": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "total",
        "not_started",
        "running",
        "completed",
        "failed",
        "skipped",
        "cancelled",
        "unknown"
      ],
      "additionalProperties": false
    },
    "_untrusted": {
      "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/untrusted"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "operation_id",
    "observed_at",
    "failure_policy",
    "steps",
    "summary"
  ],
  "additionalProperties": false
}
