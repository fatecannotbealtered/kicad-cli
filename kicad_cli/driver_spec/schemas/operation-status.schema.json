{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tool-driver-cli-spec:operation-status:2.0",
  "title": "operation-status",
  "description": "One operation record as returned by operation show and by submit/status calls.",
  "type": "object",
  "properties": {
    "operation_id": {
      "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"
    },
    "capability_id": {
      "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"
    },
    "request_id": {
      "anyOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_id": {
      "anyOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:plan:2.0"
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "anyOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/target"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "planned",
        "pending",
        "running",
        "cancel_requested",
        "succeeded",
        "partial",
        "failed",
        "cancelled",
        "unknown"
      ]
    },
    "stage": {
      "anyOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/timestamp"
    },
    "started_at": {
      "anyOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "anyOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "wait_timeout_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_deadline": {
      "anyOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "progress": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "observed",
                "estimated"
              ]
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "note": {
              "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "record": {
      "type": "object",
      "properties": {
        "availability": {
          "enum": [
            "available",
            "expired",
            "unavailable"
          ]
        },
        "retain_until": {
          "anyOf": [
            {
              "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "survives_cli_exit": {
          "type": "boolean"
        },
        "survives_reconnect": {
          "type": "boolean"
        },
        "survives_instance_restart": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
          }
        }
      },
      "required": [
        "availability",
        "retain_until",
        "survives_cli_exit",
        "survives_reconnect",
        "survives_instance_restart",
        "limitations"
      ],
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "properties": {
        "lookup": {
          "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/read_command"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/read_command"
            },
            {
              "type": "null"
            }
          ]
        },
        "cancel": {
          "anyOf": [
            {
              "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/control_command"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "lookup",
        "result",
        "cancel"
      ],
      "additionalProperties": false
    },
    "blocked": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/human_action"
            },
            "reason": {
              "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
            },
            "required_action": {
              "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
            },
            "resume": {
              "anyOf": [
                {
                  "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/control_command"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "action",
            "reason",
            "required_action",
            "resume"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "resolution": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "outcome": {
              "enum": [
                "applied",
                "not_applied",
                "partial"
              ]
            },
            "evidence": {
              "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
            },
            "resolved_at": {
              "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/timestamp"
            },
            "recorded_by": {
              "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
            }
          },
          "required": [
            "outcome",
            "evidence",
            "resolved_at",
            "recorded_by"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "stop_observed": {
      "type": "boolean"
    },
    "stop_evidence_ref": {
      "anyOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:receipt:2.0"
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "description": "A batch record: one entry per target, in plan order. Each item is its own operation with its own receipt.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
          },
          "operation_id": {
            "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"
          },
          "status": {
            "enum": [
              "planned",
              "pending",
              "running",
              "cancel_requested",
              "succeeded",
              "partial",
              "failed",
              "cancelled",
              "unknown"
            ]
          }
        },
        "required": [
          "key",
          "operation_id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "_untrusted": {
      "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/untrusted"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "operation_id",
    "capability_id",
    "request_id",
    "plan_id",
    "target",
    "status",
    "stage",
    "observed_at",
    "started_at",
    "finished_at",
    "record",
    "commands",
    "blocked",
    "resolution",
    "stop_observed",
    "receipt"
  ],
  "additionalProperties": false
}
