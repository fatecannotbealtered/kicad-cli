{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tool-driver-cli-spec:evidence:2.0",
  "title": "evidence",
  "type": "object",
  "properties": {
    "evidence_id": {
      "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"
    },
    "spec_version": {
      "allOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/semver"
        },
        {
          "pattern": "^[0-9]+\\."
        }
      ]
    },
    "schema_version": {
      "const": "2.0"
    },
    "evidence_context": {
      "enum": [
        "development",
        "release"
      ]
    },
    "kind": {
      "enum": [
        "contract",
        "simulated_adapter",
        "real_application",
        "artifact_consumer",
        "manual_review"
      ]
    },
    "source_commit": {
      "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/commit"
    },
    "source_fingerprint_sha256": {
      "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/sha256"
    },
    "package_sha256": {
      "anyOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "recorded_at": {
      "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/timestamp"
    },
    "environment": {
      "type": "object",
      "properties": {
        "platform": {
          "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
        },
        "arch": {
          "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
              },
              "role": {
                "enum": [
                  "cli",
                  "adapter",
                  "service",
                  "plugin",
                  "application",
                  "device",
                  "runtime",
                  "validator"
                ]
              },
              "version": {
                "anyOf": [
                  {
                    "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "build_id": {
                "anyOf": [
                  {
                    "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "location": {
                "enum": [
                  "disk",
                  "running",
                  "remote",
                  "unknown"
                ]
              },
              "identity_status": {
                "enum": [
                  "observed",
                  "unavailable",
                  "not_applicable"
                ]
              },
              "reason": {
                "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
              }
            },
            "required": [
              "name",
              "role",
              "version",
              "build_id",
              "location",
              "identity_status"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "identity_status": {
                      "enum": [
                        "unavailable",
                        "not_applicable"
                      ]
                    }
                  },
                  "required": [
                    "identity_status"
                  ]
                },
                "then": {
                  "required": [
                    "reason"
                  ]
                }
              }
            ]
          }
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "platform",
        "arch",
        "components"
      ],
      "additionalProperties": false
    },
    "input_fingerprint_sha256": {
      "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/sha256"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/target"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot_id": {
      "anyOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/check"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "evidence_id",
    "spec_version",
    "schema_version",
    "evidence_context",
    "kind",
    "source_commit",
    "source_fingerprint_sha256",
    "package_sha256",
    "recorded_at",
    "environment",
    "input_fingerprint_sha256",
    "target",
    "snapshot_id",
    "capabilities",
    "commands",
    "checks",
    "limitations"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_context": {
            "const": "release"
          }
        },
        "required": [
          "evidence_context"
        ]
      },
      "then": {
        "properties": {
          "package_sha256": {
            "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/sha256"
          }
        }
      }
    }
  ]
}
