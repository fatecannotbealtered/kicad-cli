{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tool-driver-cli-spec:scope:2.0",
  "title": "scope",
  "description": "A task scope record. A person writes it (or tells an agent to); the CLI only reads it. Its absence means read-only.",
  "type": "object",
  "properties": {
    "scope_id": {
      "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"
    },
    "tool": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "granted_by": {
      "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
    },
    "granted_at": {
      "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/timestamp"
    },
    "expires_at": {
      "anyOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "revoked": {
      "type": "boolean"
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/effect"
      }
    },
    "dangerous": {
      "type": "boolean"
    },
    "roots": {
      "description": "Absolute directories whose files may be changed or saved.",
      "type": "array",
      "items": {
        "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
      }
    },
    "outputs": {
      "description": "Absolute directories where new artifacts may be written.",
      "type": "array",
      "items": {
        "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
      }
    },
    "destinations": {
      "description": "Prefixes of the delivery destinations allowed for the deliver effect.",
      "type": "array",
      "items": {
        "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "engine_id": {
            "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"
          },
          "instance_id": {
            "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"
          },
          "object_id": {
            "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/id"
          },
          "locator_prefix": {
            "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
          }
        },
        "minProperties": 1,
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_operations": {
          "description": "Confirmed operations allowed under this scope.",
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "$ref": "urn:tool-driver-cli-spec:common:2.0#/$defs/text"
    }
  },
  "required": [
    "scope_id",
    "tool",
    "granted_by",
    "granted_at",
    "expires_at",
    "effects",
    "dangerous",
    "roots",
    "outputs"
  ],
  "additionalProperties": false
}
