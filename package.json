{
  "name": "@fateforge/kicad-cli",
  "version": "1.0.2",
  "private": true,
  "description": "KiCad CLI for AI assistants: project libraries, schematic and PCB editing, checks, and fabrication exports",
  "license": "Apache-2.0",
  "author": "Sean Guo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatecannotbealtered/kicad-cli.git"
  },
  "bin": {
    "kicad-cli": "scripts/run.js"
  },
  "scripts": {
    "version": "node scripts/sync-version.js",
    "check-version": "node scripts/check-version.js"
  },
  "optionalDependencies": {
    "@fateforge/kicad-cli-darwin-arm64": "1.0.2",
    "@fateforge/kicad-cli-darwin-x64": "1.0.2",
    "@fateforge/kicad-cli-linux-arm64": "1.0.2",
    "@fateforge/kicad-cli-linux-x64": "1.0.2",
    "@fateforge/kicad-cli-win32-arm64": "1.0.2",
    "@fateforge/kicad-cli-win32-x64": "1.0.2"
  },
  "files": [
    "scripts/run.js",
    "skills/",
    "README.md",
    "README_zh.md",
    "*_zh.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "AGENTS.md",
    ".agent/",
    "docs/",
    "third_party/"
  ],
  "engines": {
    "node": ">=16"
  }
}
