  "commands": [
    {
      "path": "board footprint move",
      "type": "write",
      "description": "Move explicit footprints and independently read the saved poses back.",
      "params": [
        {
          "name": "board",
          "type": "string",
          "required": true,
          "multiple": false,
          "description": "Explicit existing .kicad_pcb file; resolved file URI is the target."
        },
        {
          "name": "moves",
          "type": "string",
          "required": true,
          "multiple": false,
          "description": "REF:x,y separated by semicolons; millimetres."
        }
      ],
      "output_schema": "move_receipt",
      "driver": {
        "capability_id": "board-footprint-move",
        "effects": [
          "change",
          "persist"
        ],
        "phases": [
          "plan",
          "apply",
          "verify"
        ],
        "modes": [
          "file"
        ],
        "maturity": "experimental",
        "environments": [
          {
            "application": "KiCad saved board file",
            "application_version": "10.0.6 readback checkpoint; other versions untested",
            "platform": "windows",
            "arch": "x64",
            "adapter_version": "2.0.0",
            "mode": "file",
            "limitations": [
              "No GUI write or native DRC in this adapter; independent bounded file consumer."
            ]
          }
        ],
        "limits": [
          "Named unique footprint references only; translation in millimetres, 1 nm readback tolerance.",
          "No side/angle/DRC/connectivity/manufacturing acceptance; non-pose content must remain byte-identical.",
          "Only move, zone create/refill and project sync writers use driver runtime 2.0; other writers remain explicitly legacy.",
          "Recovery records an actual re-observation; never repeats a lost write or restores an externally changed board."
        ],
        "recovery": {
          "atomicity": "unknown",
          "undo": false,
          "idempotent": false,
          "cancel": false
        },
        "profiles": [
          "core"
        ],
        "error_codes": [
          "E_USAGE",
          "E_VALIDATION",
          "E_NOT_FOUND",
          "E_IO",
          "E_CONFIG",
          "E_FORBIDDEN",
          "E_CONFIRMATION_REQUIRED",
          "E_CONFLICT",
          "E_BUSY",
          "E_NATIVE_FAILURE",
          "E_PARTIAL",
          "E_OUTCOME_UNKNOWN",
          "E_VERIFY_FAILED",
          "E_VERIFY_INCOMPLETE",
          "E_UNKNOWN"
        ],
        "evidence_refs": []
      },
      "examples": [
        "kicad-cli board footprint move --board <file> --moves R1:101.25,100.5 --dry-run",
        "kicad-cli board footprint move --board <file> --moves R1:101.25,100.5 --confirm <confirm_token>"
      ]
    },
    {
      "path": "board zone create",
      "type": "write",
      "description": "Create an unfilled copper zone with fresh saved-file observation and bounded custom findings.",
      "params": [
        {
          "name": "board",
          "type": "string",
          "required": true,
          "multiple": false,
          "description": "Explicit existing saved .kicad_pcb; resolved URI and byte revision bind the target."
        },
        {
          "name": "net",
          "type": "string",
          "required": true,
          "multiple": false,
          "description": "Existing board net, exact name."
        },
        {
          "name": "layer",
          "type": "string",
          "required": true,
          "multiple": false,
          "description": "Existing copper layer or its user alias."
        },
        {
          "name": "margin",
          "type": "number",
          "required": false,
          "multiple": false,
          "default": 0.5,
          "unit": "mm",
          "description": "Nonnegative inset from Edge.Cuts bounding box."
        },
        {
          "name": "clearance",
          "type": "number",
          "required": false,
          "multiple": false,
          "default": 0.3,
          "unit": "mm",
          "description": "Positive zone clearance."
        },
        {
          "name": "min-width",
          "type": "number",
          "required": false,
          "multiple": false,
          "default": 0.25,
          "unit": "mm",
          "description": "Positive minimum zone copper width."
        },
        {
          "name": "connect",
          "type": "string",
          "required": false,
          "multiple": false,
          "default": "thermal",
          "enum": [
            "thermal",
            "solid"
          ],
          "description": "Pad connection mode."
        }
      ],
      "output_schema": "zone_receipt",
      "driver": {
        "capability_id": "board-zone-create",
        "effects": [
          "change",
          "persist"
        ],
        "phases": [
          "plan",
          "apply",
          "verify"
        ],
        "modes": [
          "file"
        ],
        "maturity": "experimental",
        "environments": [
          {
            "application": "KiCad saved board file",
            "application_version": "10.0.6 readback checkpoint; other versions untested",
            "platform": "windows",
            "arch": "x64",
            "adapter_version": "2.0.0",
            "mode": "file",
            "limitations": [
              "Saved-byte consumer plus bounded custom finding gate; writer geometry/parser shared by checker.",
              "Native SDK loading and official DRC remain separate evidence."
            ]
          }
        ],
        "limits": [
          "Create an unfilled board-outline bounding rectangle for one existing net/layer; or refill selected existing copper-zone UUIDs.",
          "Non-target parsed semantics and refill definitions preserved; serialization can change whitespace.",
          "Bind board byte snapshot, complete scope, prepared result and present/absent project/rule dependencies before dispatch.",
          "Custom finding multiset gate excludes warnings/unconnected and unsupported rules; not official DRC or geometry/manufacturing acceptance.",
          "Recovery re-observes current board and never retries or restores an external edit.",
          "Create declares modern filled_areas_thickness=no; refill refuses selected missing/yes legacy/stroked markers without changing their definitions."
        ],
        "recovery": {
          "atomicity": "unknown",
          "undo": false,
          "idempotent": false,
          "cancel": false
        },
        "profiles": [
          "core"
        ],
        "error_codes": [
          "E_USAGE",
          "E_VALIDATION",
          "E_NOT_FOUND",
          "E_IO",
          "E_CONFIG",
          "E_FORBIDDEN",
          "E_CONFIRMATION_REQUIRED",
          "E_CONFLICT",
          "E_BUSY",
          "E_NATIVE_FAILURE",
          "E_PARTIAL",
          "E_OUTCOME_UNKNOWN",
          "E_VERIFY_FAILED",
          "E_VERIFY_INCOMPLETE",
          "E_UNKNOWN"
        ],
        "evidence_refs": []
      },
      "examples": [
        "kicad-cli board zone create --board <file> --net GND --layer F.Cu --dry-run",
        "kicad-cli board zone create --board <file> --net GND --layer F.Cu --confirm <confirm_token>"
      ]
    },
