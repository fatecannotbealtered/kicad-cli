{
  "registry_version": "2.0",
  "name": "kicad-cli",
  "product_version": "2.0.0",
  "description": "Incremental real saved-board writes, project sync and four saved-document observations.",
  "risk_tier": "T1",
  "builtins": {
    "maturity": "experimental",
    "evidence_refs": []
  },
  "record": {
    "store": "SQLite in KICAD_CLI_STATE_DIR, default ~/.kicad-cli",
    "retain_days": 30,
    "survives_cli_exit": true,
    "survives_reconnect": true,
    "survives_instance_restart": true,
    "limitations": [
      "Machine-local records; a killed synchronous writer becomes unknown after its 30-second lease.",
      "Listed writes and operation management need valid on-disk local state; four observations do not open the operation store."
    ]
  },
