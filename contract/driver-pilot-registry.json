      "params": [
        {
          "name": "board",
          "type": "string",
          "required": true,
          "multiple": false,
          "description": "Explicit existing saved PCB; the only write target."
        },
        {
          "name": "schematic",
          "type": "string",
          "required": true,
          "multiple": false,
          "description": "Explicit root schematic; entire referenced hierarchy is observed and bound."
