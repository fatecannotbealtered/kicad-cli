      {"case": "npm_not_found", "code": "E_CONFIG", "after": "unchanged"},
      {"case": "running_program_not_movable", "code": "E_IO", "after": "unchanged"},
      {"case": "install_failed_or_wrong_version", "code": "E_IO", "after": "previous_version"},
      {"case": "provenance_check_failed", "code": "E_INTEGRITY", "after": "reported_as_installed"},
      {"case": "skill_sync_failed", "code": "E_PARTIAL", "after": "new_tool_old_skills"}
    ]
